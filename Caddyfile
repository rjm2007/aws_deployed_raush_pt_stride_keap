# Replace with the subdomain you point at this EC2 instance.
# Caddy obtains and renews the TLS certificate automatically.
demo.aibolt.ai {
    request_body /api/v1/dashboard/assistant {
        max_size 64KB
    }
    # While the API restarts (a deploy), hold requests and retry for up to 15 s
    # instead of answering 502 at once: under Vapi's 20 s tool timeout, so a
    # live call rides through a deploy.
    reverse_proxy api:8000 {
        lb_try_duration 15s
        lb_try_interval 250ms
    }
}

# Staff dashboard (moved from Vercel). DNS A record -> this server's Elastic IP.
# The dashboard calls the api inside Docker (http://api:8000), not through this host.
dashboard.demo.aibolt.ai {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    reverse_proxy dashboard:3000 {
        lb_try_duration 15s
        lb_try_interval 250ms
    }
}

# Mock Stride test app (moved from Vercel). DNS A record -> this server's Elastic IP.
# The app has its own password (Basic auth); the 5-minute cron calls /api/cron/export here.
mock.demo.aibolt.ai {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        -Server
    }
    reverse_proxy mock-stride:3100
}
